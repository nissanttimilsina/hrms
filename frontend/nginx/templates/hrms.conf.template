# Generated from a template at container start: ${ROOT_DOMAIN}, ${MARKETING_HOST} and ${MARKETING_REDIRECT_HOST}
# are substituted from the environment (the web service sets them from .env).
# Certificates: one wildcard certificate for ${ROOT_DOMAIN} and *.${ROOT_DOMAIN} in /etc/nginx/certs.

upstream hrms_api { server api:4000; keepalive 32; }

limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=forms:10m rate=20r/m;

server_tokens off;
client_max_body_size 25m;
gzip on;
gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

ssl_certificate     /etc/nginx/certs/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

# HTTP: ACME challenges, otherwise redirect to HTTPS
server {
  listen 80 default_server;
  server_name _;
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  # Many biometric terminals cannot do HTTPS: allow only the device protocol over plain HTTP.
  location /iclock/ { include /etc/nginx/snippets/proxy.conf; }
  location = /healthz { access_log off; return 200 "ok\n"; }
  location / { return 301 https://$host$request_uri; }
}

# The other public-site hostname (apex or www) redirects to the canonical one.
server {
  listen 443 ssl;
  http2 on;
  server_name ${MARKETING_REDIRECT_HOST};
  include /etc/nginx/snippets/security.conf;
  return 301 https://${MARKETING_HOST}$request_uri;
}

# Marketing website (prerendered pages; unknown paths fall back to the client-side shell)
server {
  listen 443 ssl;
  http2 on;
  server_name ${MARKETING_HOST};
  root /srv/marketing;
  include /etc/nginx/snippets/security.conf;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
  include /etc/nginx/snippets/api.conf;
  include /etc/nginx/snippets/static.conf;
  location / { try_files $uri $uri/index.html /_shell.html; }
}

# Super Admin portal
server {
  listen 443 ssl;
  http2 on;
  server_name admin.${ROOT_DOMAIN};
  root /srv/admin;
  include /etc/nginx/snippets/security.conf;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
  add_header X-Robots-Tag "noindex, nofollow" always;
  include /etc/nginx/snippets/api.conf;
  include /etc/nginx/snippets/static.conf;
  location / { try_files $uri /index.html; }
}

# Company app: app.${ROOT_DOMAIN} and every <company>.${ROOT_DOMAIN}
server {
  listen 443 ssl default_server;
  http2 on;
  server_name app.${ROOT_DOMAIN} *.${ROOT_DOMAIN};
  root /srv/app;
  include /etc/nginx/snippets/security.conf;
  # form-action allows the eSewa payment form post (sandbox and live).
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self' https://epay.esewa.com.np https://rc-epay.esewa.com.np; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; worker-src 'self'" always;
  add_header X-Robots-Tag "noindex, nofollow" always;
  include /etc/nginx/snippets/api.conf;
  include /etc/nginx/snippets/static.conf;
  location / { try_files $uri /index.html; }
}
