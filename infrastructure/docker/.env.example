# =============================================================================
# Production configuration for docker compose. Copy to .env next to this file,
# set permissions to 600, and replace every CHANGE_ME. NEVER commit the .env.
# Generate secrets with:   openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
# Encryption key (32 bytes): openssl rand -base64 32
# =============================================================================

# --- Domain -----------------------------------------------------------------
# Marketing site at www.<ROOT_DOMAIN>, Super Admin at admin.<ROOT_DOMAIN>,
# companies at <company>.<ROOT_DOMAIN> and app.<ROOT_DOMAIN>.
ROOT_DOMAIN=yourhrms.com
# Public website host, and the alternative host that redirects to it. Two common layouts:
#   own domain (yourhrms.com):        MARKETING_HOST=www.yourhrms.com   MARKETING_REDIRECT_HOST=yourhrms.com
#   subdomain (hrms.example.com):     MARKETING_HOST=hrms.example.com  MARKETING_REDIRECT_HOST=www.hrms.example.com
MARKETING_HOST=www.yourhrms.com
MARKETING_REDIRECT_HOST=yourhrms.com
BRAND_NAME="Lishnu HRMS"
CONTACT_EMAIL=hello@yourhrms.com
# CONTACT_PHONE=
CERTS_DIR=/etc/hrms/certs

# --- Database & cache (internal network only) -----------------------------
POSTGRES_PASSWORD=CHANGE_ME
HRMS_OWNER_PASSWORD=CHANGE_ME
HRMS_APP_PASSWORD=CHANGE_ME
HRMS_SYSTEM_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
DB_POOL_MAX=15

# --- Security ----------------------------------------------------------------
# At least 48 random characters. Rotating it signs everyone out.
JWT_ACCESS_SECRET=CHANGE_ME
# 32-byte base64 key that encrypts bank account numbers. Back it up separately:
# without it, encrypted fields in backups cannot be read. Never rotate it casually.
DATA_ENCRYPTION_KEY=CHANGE_ME
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
ENABLE_API_DOCS=false
LOG_LEVEL=info

# --- First Super Admin (used by the seed on first start; remove afterwards) ---
SEED_SUPERADMIN_EMAIL=admin@yourhrms.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_Strong#Pass1

# --- Email (required in production) -----------------------------------------
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
EMAIL_FROM="Lishnu HRMS <no-reply@yourhrms.com>"
SALES_NOTIFY_EMAIL=sales@yourhrms.com

# --- Payments -----------------------------------------------------------------
# Comma-separated: ESEWA, KHALTI, BANK_TRANSFER. Live credentials are required for
# ESEWA/KHALTI in production (the API refuses to start with sandbox settings).
PAYMENTS_ENABLED=BANK_TRANSFER
# ESEWA_PRODUCT_CODE=
# ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://epay.esewa.com.np/api/epay/transaction/status/
# KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://khalti.com/api/v2

# --- File storage ---------------------------------------------------------------
# local = Docker volume "uploads" (included in the VPS backup); s3 = any S3-compatible store.
STORAGE_DRIVER=local
MAX_UPLOAD_MB=10
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
