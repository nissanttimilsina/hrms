# ---------------------------------------------------------------------------
# HRMS API configuration. Copy to .env for local development.
# NEVER commit real secrets. In staging/production inject these from a
# secret manager (Docker secrets, AWS SSM/Secrets Manager, Vault, ...).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Three Postgres roles (see infrastructure/docker/postgres/00-roles.sh)
DATABASE_URL_OWNER=postgresql://hrms_owner:CHANGE_ME@localhost:5432/hrms     # migrations only
DATABASE_URL_APP=postgresql://hrms_app:CHANGE_ME@localhost:5432/hrms         # RLS-enforced tenant traffic
DATABASE_URL_SYSTEM=postgresql://hrms_system:CHANGE_ME@localhost:5432/hrms   # platform/auth/jobs (BYPASSRLS)
DB_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ISSUER=hrms-platform
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Domains: tenants get <slug>.<ROOT_DOMAIN>
# app./admin./www.<ROOT_DOMAIN> and their https URLs are derived automatically.
# Local development: hrms.localhost works without DNS changes in modern browsers.
ROOT_DOMAIN=hrms.localhost
# APP_HOST / ADMIN_HOST / MARKETING_HOST / APP_URL / ADMIN_URL / MARKETING_URL  (override only if needed)
CORS_ORIGINS=
TRUST_PROXY=1
COOKIE_SECURE=false

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
ENABLE_API_DOCS=true

# Email: "log" prints emails to the worker log in development; production requires "smtp".
EMAIL_TRANSPORT=log
# SMTP_HOST= SMTP_PORT=587 SMTP_SECURE=false SMTP_USER= SMTP_PASS=
EMAIL_FROM="Lishnu HRMS <no-reply@yourhrms.com>"
# SALES_NOTIFY_EMAIL=

# Payments: sandbox credentials are the defaults in development.
PAYMENTS_ENABLED=ESEWA,KHALTI,BANK_TRANSFER
# KHALTI_SECRET_KEY=   (sandbox key from test-admin.khalti.com)

# 32-byte base64 key for field encryption (bank account numbers). openssl rand -base64 32
# DATA_ENCRYPTION_KEY=   (a dev-only default is used when unset)

# File storage: local (./storage) or s3
STORAGE_DRIVER=local
MAX_UPLOAD_MB=10

# Seeding (first deploy only)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
